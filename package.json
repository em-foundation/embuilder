{
    "name": "embrowser",
    "displayName": "EM•Browser",
    "description": "viewer for EM•Script content",
    "version": "0.0.1",
    "publisher": "the-em-foundation",
    "icon": "icons/logo12.png",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/em-foundation/embrowser"
    },
    "engines": {
        "vscode": "^1.80.0"
    },
    "scripts": {
        "build": "tsc -p .",
        "publish-dev": "npm version prerelease --preid dev --no-git-tag-version && npm run build && vsce publish --pre-release --allow-star-activation",
        "vsce-pack": "vsce pack --allow-star-activation",
        "watch": "tsc -w -p ."
    },
    "devDependencies": {
        "@types/node": "^25.0.3",
        "@types/vscode": "^1.80.0",
        "typescript": "^5.7.2"
    },
    "categories": [
        "Themes"
    ],
    "main": "./out/extension.js",
    "browser": "./out/extension.js",
    "activationEvents": [
        "*"
    ],
    "extensionKind": [
        "ui"
    ],
    "contributes": {
        "iconThemes": [
            {
                "id": "emscript-icons",
                "label": "EM•Script Icons",
                "path": "./icon-theme.json"
            }
        ],
        "semanticTokenScopes": [
            {
                "scopes": {
                    "em-debug": [],
                    "em-domain": [],
                    "em-ident": [],
                    "em-special": [],
                    "em-unit": [],
                    "em-wrong": []
                }
            }
        ],
        "themes": [
            {
                "label": "EM•Script Dark",
                "uiTheme": "vs-dark",
                "path": "./themes/em-dark-color-theme.json"
            }
        ]
    }
}