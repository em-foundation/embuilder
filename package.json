{
    "name": "emscript-browser",
    "displayName": "EM•Script Browser",
    "description": "EMS file/folder icons for vscode.dev/github.dev",
    "version": "0.0.1",
    "publisher": "the-em-foundation",
    "license": "MIT",
    "engines": {
        "vscode": "^1.80.0"
    },
    "scripts": {
        "build": "tsc -p .",
        "watch": "tsc -w -p ."
    },
    "devDependencies": {
        "@types/node": "^25.0.3",
        "@types/vscode": "^1.80.0",
        "typescript": "^5.7.2"
    },
    "categories": [
        "Themes"
    ],
    "main": "./out/extension.js",
    "browser": "./out/extension.js",
    "activationEvents": [
        "*"
    ],
    "extensionKind": [
        "ui"
    ],
    "contributes": {
        "iconThemes": [
            {
                "id": "emscript-icons",
                "label": "EM•Script Icons",
                "path": "./icon-theme.json"
            }
        ]
    }
}
