{
    "name": "embrowser",
    "displayName": "EM•Browser",
    "description": "VS Code support for EM•Script",
    "version": "26.0.17",
    "publisher": "the-em-foundation",
    "icon": "icons/logo12.png",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/em-foundation/embrowser"
    },
    "engines": {
        "vscode": "^1.80.0"
    },
    "main": "./out/extension.js",
    "scripts": {
        "build": "npm run typecheck && esbuild src/extension.ts --bundle --format=cjs --platform=node --external:vscode --outfile=out/extension.js",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "publish-dev": "npm version patch --no-git-tag-version && npm run build && vsce publish --pre-release --allow-star-activation",
        "vsce-pack": "npm run build && vsce pack --allow-star-activation"
    },
    "devDependencies": {
        "@types/js-yaml": "^4.0.9",
        "@types/markdown-it": "^14.1.2",
        "@types/node": "^25.0.10",
        "@types/vscode": "^1.80.0",
        "esbuild": "^0.27.2",
        "typescript": "^5.7.2"
    },
    "categories": [
        "Programming Languages"
    ],
    "extensionKind": [
        "workspace"
    ],
    "activationEvents": [
        "*"
    ],
    "contributes": {
        "commands": [
            {
                "command": "embrowser.openReadonly",
                "title": "EM•Browser: Open Readonly"
            },
            {
                "command": "embrowser.revealInExplorer",
                "title": "EM•Browser: Reveal in Explorer"
            },
            {
                "command": "em.tour.start",
                "title": "EM•Browser: Start Tour"
            },
            {
                "command": "em.tour.end",
                "title": "End",
                "icon": "$(trash)"
            },
            {
                "command": "em.tour.next",
                "title": "Next",
                "icon": "$(debug-continue)"
            },
            {
                "command": "em.tour.prev",
                "title": "Back",
                "icon": "$(debug-reverse-continue)"
            },
            {
                "command": "em.tour.refresh",
                "title": "Refresh",
                "icon": "$(debug-restart)"
            },
            {
                "command": "em.tour.restart",
                "title": "Restart",
                "icon": "$(home)"
            }
        ],
        "menus": {
            "commandPalette": [
                {
                    "command": "em.tour.start",
                    "when": "false"
                },
                {
                    "command": "em.tour.end",
                    "when": "false"
                },
                {
                    "command": "em.tour.next",
                    "when": "false"
                },
                {
                    "command": "em.tour.prev",
                    "when": "false"
                },
                {
                    "command": "em.tour.refresh",
                    "when": "false"
                },
                {
                    "command": "em.tour.restart",
                    "when": "false"
                }
            ],
            "view/item/context": [
                {
                    "command": "embrowser.revealInExplorer",
                    "when": "view == embrowser.content && viewItem == embrowser.nodeHasUri",
                    "group": "navigation@10"
                }
            ],
            "view/title": [
                {
                    "command": "em.tour.prev",
                    "when": "view == em.toursView",
                    "group": "navigation@1"
                },
                {
                    "command": "em.tour.next",
                    "when": "view == em.toursView",
                    "group": "navigation@2"
                },
                {
                    "command": "em.tour.refresh",
                    "when": "view == em.toursView",
                    "group": "navigation@3"
                },
                {
                    "command": "em.tour.restart",
                    "when": "view == em.toursView",
                    "group": "navigation@4"
                },
                {
                    "command": "em.tour.end",
                    "when": "view == em.toursView",
                    "group": "navigation@5"
                }
            ]
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "embrowser",
                    "title": "EM•Browser",
                    "icon": "icons/logo-mono.svg"
                }
            ]
        },
        "views": {
            "embrowser": [
                {
                    "id": "embrowser.content",
                    "name": "",
                    "icon": "icons/logo-mono.svg"
                }
            ],
            "explorer": [
                {
                    "type": "webview",
                    "id": "em.toursView",
                    "name": "EM•Browser Tour Guide"
                }
            ]
        },
        "semanticTokenScopes": [
            {
                "scopes": {
                    "em-debug": [],
                    "em-domain": [],
                    "em-ident": [],
                    "em-special": [],
                    "em-unit": [],
                    "em-wrong": []
                }
            }
        ],
        "themes": [
            {
                "label": "EM•Script Dark",
                "uiTheme": "vs-dark",
                "path": "./themes/em-dark-color-theme.json"
            }
        ]
    },
    "dependencies": {
        "js-yaml": "^4.1.1",
        "markdown-it": "^14.1.0"
    }
}
