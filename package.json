{
    "name": "embrowser",
    "displayName": "EM•Browser",
    "description": "viewer for EM•Script content",
    "version": "26.0.3",
    "publisher": "the-em-foundation",
    "icon": "icons/logo12.png",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/em-foundation/embrowser"
    },
    "engines": {
        "vscode": "^1.80.0"
    },
    "scripts": {
        "build:node": "tsc -p tsconfig.node.json",
        "build:web": "esbuild src/extension.ts --bundle --format=cjs --platform=browser --external:vscode --external:typescript --outfile=out/web/extension.js",
        "build": "npm run build:node && npm run build:web",
        "publish-dev": "npm version patch --no-git-tag-version && npm run build && vsce publish --pre-release --allow-star-activation",
        "vsce-pack": "vsce pack --allow-star-activation",
        "watch-cli": "tsc -w -p tsconfig.node.json"
    },
    "devDependencies": {
        "@types/node": "^25.0.3",
        "@types/vscode": "^1.80.0",
        "esbuild": "^0.27.2",
        "typescript": "^5.7.2"
    },
    "categories": [
        "Themes"
    ],
    "main": "./out/node/extension.js",
    "browser": "./out/web/extension.js",
    "activationEvents": [
        "*"
    ],
    "extensionKind": [
        "ui"
    ],
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "embrowser",
                    "title": "EM•Browser",
                    "icon": "icons/logo-mono.svg"
                }
            ]
        },
        "views": {
            "embrowser": [
                {
                    "id": "embrowser.content",
                    "name": "EM•porium"
                }
            ]
        },
        "iconThemes": [
            {
                "id": "emscript-icons",
                "label": "EM•Script Icons",
                "path": "./icon-theme.json"
            }
        ],
        "semanticTokenScopes": [
            {
                "scopes": {
                    "em-debug": [],
                    "em-domain": [],
                    "em-ident": [],
                    "em-special": [],
                    "em-unit": [],
                    "em-wrong": []
                }
            }
        ],
        "themes": [
            {
                "label": "EM•Script Dark",
                "uiTheme": "vs-dark",
                "path": "./themes/em-dark-color-theme.json"
            }
        ]
    }
}