{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ES2022",
        "lib": ["ES2022", "DOM", "WebWorker"],        
        "rootDir": "src",
        "outDir": "out",
        "strict": true,
        "sourceMap": true,
        "moduleResolution": "Bundler",
        "skipLibCheck": true,
        "types": ["vscode"]
    },
    "include": ["src/**/*.ts"]
}

