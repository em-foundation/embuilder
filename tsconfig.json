{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ES2022",
        "lib": ["ES2020", "WebWorker"],
        "rootDir": "src",
        "outDir": "out",
        "strict": true,
        "sourceMap": true,
        "moduleResolution": "Bundler",
        "skipLibCheck": true
    },
    "include": ["src/**/*.ts"]
}
